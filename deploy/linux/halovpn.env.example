# Copy to /etc/halovpn/halovpn.env, owner root:halovpn, mode 0640.
# Replace every placeholder. Never commit the populated file.
HALOVPN_DATABASE=Host=/var/run/postgresql;Database=halovpn;Username=halovpn_app;Password=REPLACE_ME
Tokens__Issuer=HaloVPN.ControlPlane
Tokens__Audience=HaloVPN.Windows
Tokens__SigningKeyBase64=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES_BASE64
VpnNode__Name=Astana-1
VpnNode__PublicHost=REPLACE_WITH_DNS_NAME_OR_PUBLIC_IP
VpnNode__UdpPort=45000
VpnNode__PublicKeyBase64=REPLACE_WITH_NODE_PUBLIC_KEY_BASE64
VpnNode__TunnelSubnet=10.77.0.0/24
VpnNode__TunnelGateway=10.77.0.1
VpnNode__DnsServers__0=1.1.1.1
VpnNode__Mtu=1200
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=https://0.0.0.0:8443
Kestrel__Certificates__Default__Path=/etc/halovpn/tls/controlplane.pfx
Kestrel__Certificates__Default__Password=REPLACE_ME
