# Use a PostgreSQL role restricted to SELECT on users/devices for the node.
HALOVPN_DATABASE=Host=/var/run/postgresql;Database=halovpn;Username=halovpn_node;Password=REPLACE_ME
Node__ListenAddress=0.0.0.0
Node__UdpPort=45000
Node__PrivateKeyPath=/etc/halovpn/node.key
Node__TunName=halo0
Node__TunnelGatewayCidr=10.77.0.1/24
Node__Mtu=1200
Node__MaximumActiveSessions=16
Node__MaximumPendingHandshakes=32
Node__MaximumPendingPerSource=4
Node__AuthorizationRefreshInterval=00:00:15
Node__MaximumAuthorizationStaleAge=00:02:00
Node__MaximumHandshakeResponseCacheEntries=128
Node__MaximumHandshakeResponseCacheEntriesPerSource=8
Node__HandshakeResponseCacheTtl=00:00:15
Node__DeniedDestinationCidrs__0=0.0.0.0/8
Node__DeniedDestinationCidrs__1=10.0.0.0/8
Node__DeniedDestinationCidrs__2=100.64.0.0/10
Node__DeniedDestinationCidrs__3=127.0.0.0/8
Node__DeniedDestinationCidrs__4=169.254.0.0/16
Node__DeniedDestinationCidrs__5=172.16.0.0/12
Node__DeniedDestinationCidrs__6=192.0.0.0/24
Node__DeniedDestinationCidrs__7=192.0.2.0/24
Node__DeniedDestinationCidrs__8=192.88.99.0/24
Node__DeniedDestinationCidrs__9=192.168.0.0/16
Node__DeniedDestinationCidrs__10=198.18.0.0/15
Node__DeniedDestinationCidrs__11=198.51.100.0/24
Node__DeniedDestinationCidrs__12=203.0.113.0/24
Node__DeniedDestinationCidrs__13=224.0.0.0/4
Node__DeniedDestinationCidrs__14=240.0.0.0/4
