[Unit]
Description=HaloVPN Linux Node
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=halovpn-node
Group=halovpn
WorkingDirectory=/opt/halovpn/node
EnvironmentFile=/etc/halovpn/node.env
ExecStart=/usr/bin/dotnet /opt/halovpn/node/HaloVPN.Node.dll
Restart=on-failure
RestartSec=3
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
DeviceAllow=/dev/net/tun rw
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
UMask=0077

[Install]
WantedBy=multi-user.target
