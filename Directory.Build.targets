<Project>
  <ItemGroup Condition="'$(SkipHaloNativeCopy)' != 'true' and Exists('$(MSBuildThisFileDirectory)artifacts\native\$(Configuration)\win-x64\halo_protocol.dll')">
    <None Include="$(MSBuildThisFileDirectory)artifacts\native\$(Configuration)\win-x64\halo_protocol.dll"
          Link="halo_protocol.dll"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
